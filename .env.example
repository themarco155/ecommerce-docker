# ============================================================
#  Variables del ecosistema. Copia este archivo:  cp .env.example .env
#  docker compose lee el .env automáticamente.
# ============================================================

# ---------- Base de datos (MySQL 8) ----------
# Nombre de la base que se crea en el primer arranque
DB_DATABASE=ecommerce_api
# Usuario de la API (solo tiene permisos sobre DB_DATABASE)
DB_USERNAME=ecommerce
# Contraseña del usuario de la API  (OBLIGATORIA, cámbiala)
DB_PASSWORD=cambia_esta_clave
# Contraseña de root de MySQL  (OBLIGATORIA, cámbiala)
DB_ROOT_PASSWORD=cambia_esta_clave_root

# ---------- Backend (API Laravel) ----------
# Clave de cifrado de Laravel. Formato: base64:XXXXXXXX  (OBLIGATORIA, ver README para generarla)
APP_KEY=
# URL pública de la API (la que abres en el navegador)
APP_URL=http://localhost:8000
# Secreto para firmar los tokens JWT  (OBLIGATORIO, ver README para generarlo)
JWT_SECRET=
# Minutos de validez del token JWT
JWT_TTL=60
# Claves de Stripe en modo prueba (https://dashboard.stripe.com/test/apikeys)
# Formato: pk_test_... (clave publicable)
STRIPE_KEY=
# Formato: sk_test_... (clave secreta, NUNCA la subas al repositorio)
STRIPE_SECRET=
# true = carga productos y el cliente de prueba la primera vez (solo si la tabla está vacía)
SEED_DATABASE=true
# Nivel de logs: debug, info, warning, error
LOG_LEVEL=warning
# Puerto del host para la API y Swagger
BACKEND_PORT=8000

# ---------- Frontend (Next.js) ----------
# Puerto del host para la tienda
FRONTEND_PORT=3000
# (Opcional) Clave PÚBLICA de Stripe para el formulario de tarjeta. Se incrusta al construir la imagen.
NEXT_PUBLIC_STRIPE_KEY=
# true solo si sirves el sitio por HTTPS (la cookie de sesión exige HTTPS)
COOKIE_SECURE=false
