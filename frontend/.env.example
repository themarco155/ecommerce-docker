# URL base de la API Laravel (incluye /api, sin "/" al final).
# Usa 127.0.0.1 y no "localhost": en Windows Node puede resolver localhost a IPv6 y fallar.
API_BASE_URL=http://127.0.0.1:8000/api

# (Opcional) Clave PÚBLICA de Stripe en modo prueba (pk_test_...).
# Si la pones, el checkout muestra el formulario real de tarjeta de Stripe Elements.
# Si la dejas vacía, el checkout usa los métodos de prueba de Stripe (pm_card_visa, etc.).
NEXT_PUBLIC_STRIPE_KEY=
